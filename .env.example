# Azure OpenAI — chat + summarize (aiEngine).
# Paste only the RESOURCE base URL (scheme + hostname), NOT the full ".../deployments/..." URL.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.cognitiveservices.azure.com

# Exactly the deployment NAME from Azure Deployments blade (often not the SKU id).
AZURE_OPENAI_CHAT_DEPLOYMENT=

# REQUIRED for clustering: embeddings deployment NAME from Deployments (not your chat model).
# Must exist on the same AZURE_OPENAI_ENDPOINT resource (e.g. text-embedding-3-small).
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Set to 1 to clear all extracted objects and re-run extraction across every chunk from scratch.
# Default (unset): only new chunks (from newly indexed documents) are processed.
#OBJECT_FULL_REFRESH=1

# Number of chunks bundled into a single GPT object-extraction call (default 20).
#OBJECT_EXTRACT_BATCH_SIZE=20

# Second pass: min cosine similarity between a chunk embedding and an object node centroid
# required to link that chunk to the node (0–1, default 0.45).
# Lower → more chunks linked per object; higher → stricter matching.
#OBJECT_ASSIGN_MIN_COSINE=0.45

# Object–object edge extraction (per-chunk top-K similarity + GPT relationship classification).
# Max similar nodes to consider per chunk when forming candidate pairs (default 6).
#EDGE_TOP_NODES_PER_CHUNK=6
# Min cosine similarity between a chunk embedding and a node centroid to include that node (default 0.35).
#EDGE_NODE_MIN_COSINE=0.35
# Max unique node pairs to send to GPT across all chunks (default 300).
#EDGE_MAX_PAIRS=300
# Number of node pairs per GPT call (default 8).
#EDGE_GPT_BATCH_SIZE=8
# Parallel GPT worker threads for edge classification (default 4).
#EDGE_GPT_WORKERS=4

# Object current-state extraction (runs after chunk assignment, before edges).
# Re-extract state for every object from scratch (default: only objects with new chunks or empty state).
#STATE_FULL_REFRESH=1
# Objects per GPT state-extraction call (default 4).
#STATE_GPT_BATCH_SIZE=4
# Max total excerpt characters fed per object (default 8000).
#STATE_MAX_EXCERPT_CHARS=8000
# Max linked chunks considered per object (default 12).
#STATE_MAX_CHUNKS_PER_NODE=12

# Optional: smaller text windows after OCR (defaults 900 / 120).
#TEXT_CHUNK_MAX_CHARS=900
#TEXT_CHUNK_OVERLAP=120

# Uncomment only if your Azure resource requires a newer API preview date than code default:
#AZURE_OPENAI_API_VERSION=

# Mistral Document AI OCR — Deployments + Endpoint (serverless curl uses no ?api-version= on URL)
# Key must belong to THIS Mistral Document deployment (often different from AZURE_OPENAI_API_KEY).
AZURE_API_KEY=

# Same key as AZURE_API_KEY if you prefer this name instead:
#MISTRAL_API_KEY=

# Full OCR URL from the deployment page (see Azure “Get Started” curl), e.g.:
# https://YOUR_RESOURCE.services.ai.azure.com/providers/mistral/azure/ocr
MISTRAL_OCR_ENDPOINT=
MISTRAL_OCR_MODEL=mistral-document-ai-2512

# Max PDF size (bytes) before splitting into parts for OCR (default 28 MB; API cap is 30 MB).
#MISTRAL_OCR_MAX_FILE_BYTES=29360128

# AWS S3 — boto3 also reads AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=srain

# Local paths (absolute or relative to project root)
NOTES_DIR=notes
# Snapshot of chunked text + embeddings alongside database.pkl (default: chunks/chunks.jsonl).
#DATABASE_CHUNKS_JSONL=my_snapshot.jsonl

# Unified pipeline (python main.py) — all default to on; set 0 to skip a phase.
#PIPELINE_INSTRUMENTS=1
#PIPELINE_POLYMARKET=1
#PIPELINE_LINK=1
#PIPELINE_EXPORT=1

# Firecrawl — optional; not used by predict-mode agent.
FIRECRAWL_API_KEY=

# Predict-mode agent (agent.py) — ephemeral state propagation through the graph.
#PREDICT_SEED_CANDIDATES=20
#PREDICT_MAX_DEPTH=4
#PREDICT_MAX_CHANGES=40
#PREDICT_GPT_WORKERS=4

# Polymarket sync — adds prediction markets as ontology nodes (via python main.py sync).
#POLYMARKET_SEARCH_LIMIT=20
#POLYMARKET_MAX_SEARCH_TERMS=25
#POLYMARKET_GPT_BATCH_SIZE=15

# Market → object linking (via python main.py link).
#MARKET_LINK_GPT_BATCH_SIZE=5
#MARKET_LINK_MAX_OBJECTS=100

# Market → market implication linking (via python main.py link).
#MARKET_MARKET_LINK_GPT_BATCH_SIZE=8
#MARKET_MARKET_TOP_K=15
#MARKET_MARKET_MIN_COSINE=0.40
#MARKET_MARKET_MAX_CATALOG=40

# Financial instruments — live price/level nodes (via python main.py sync).
#INSTRUMENTS_CONFIG=instruments.yaml
#INSTRUMENT_LINK_GPT_BATCH_SIZE=5
#INSTRUMENT_LINK_MAX_OBJECTS=100
